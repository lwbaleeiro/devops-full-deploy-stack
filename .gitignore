# ========================
# Terraform
# ========================
# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore plan files
*.tfplan

# Ignore CLI configuration files
.terraformrc
terraform.rc

# ========================
# Security / Keys
# ========================
# Ignore sensitive keys and certificates
*.pem
*.key
*.cert

# Environment variables
.env
.env.*
!.env.example

# ========================
# Python / Backend
# ========================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
ENV/

# ========================
# Node / Frontend
# ========================
node_modules/
npm-debug.log
yarn-error.log

# ========================
# OS / IDEs
# ========================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
